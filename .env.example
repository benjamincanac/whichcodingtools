# Read content/tools from GitHub at request time (production only). A fine-grained token with
# read access to the repository contents is enough. Public repos work without one, with lower rate limits.
NUXT_GITHUB_TOKEN=

# Secret of the GitHub push webhook pointed at /api/revalidate.
NUXT_WEBHOOK_SECRET=

# Random string. Also set VERCEL_BYPASS_TOKEN to the same value: Nitro bakes it into the Vercel
# output so /api/revalidate can purge ISR pages with `x-prerender-revalidate`.
NUXT_BYPASS_TOKEN=
VERCEL_BYPASS_TOKEN=

# Canonical URL, used for OG tags, sitemap and llms.txt.
NUXT_SITE_URL=https://whichcodingtools.vercel.app
