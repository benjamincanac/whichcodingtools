# Production values go in Vercel, Project > Settings > Environment Variables, or with the CLI:
#   vercel env add <NAME> production
# The CLI reads the value from stdin, so `openssl rand -hex 32 | vercel env add <NAME> production` works.

# Read content/tools from GitHub at request time (production only). Public repos work without one,
# with lower rate limits. Create a fine-grained token at
# https://github.com/settings/personal-access-tokens/new scoped to benjamincanac/whichcodingtools
# with "Contents: Read-only", then:
#   vercel env add NUXT_GITHUB_TOKEN production
NUXT_GITHUB_TOKEN=

# Secret of the GitHub push webhook. Generate with `openssl rand -hex 32`, add it to Vercel, then create
# the webhook at https://github.com/benjamincanac/whichcodingtools/settings/hooks/new with:
#   Payload URL   https://whichcodingtools.vercel.app/api/revalidate
#   Content type  application/json
#   Secret        the same value
#   Events        just the push event
NUXT_WEBHOOK_SECRET=

# Random string, `openssl rand -hex 32`. Set both to the same value in Vercel: Nitro bakes
# VERCEL_BYPASS_TOKEN into the Vercel output so /api/revalidate can purge ISR pages with
# `x-prerender-revalidate`.
#   TOKEN=$(openssl rand -hex 32)
#   echo $TOKEN | vercel env add NUXT_BYPASS_TOKEN production
#   echo $TOKEN | vercel env add VERCEL_BYPASS_TOKEN production
NUXT_BYPASS_TOKEN=
VERCEL_BYPASS_TOKEN=

# Canonical URL, used for OG tags, sitemap and llms.txt.
NUXT_SITE_URL=https://whichcodingtools.vercel.app

# Natural language finder (/api/finder/parse). On Vercel the OIDC token works without a key
# once AI Gateway is enabled for the project.
AI_GATEWAY_API_KEY=

# Gateway model id for the finder parser. Defaults to openai/gpt-5.6-luna, set this to fall
# back to anthropic/claude-sonnet-5 without a deploy. Re-check the parse prompt before moving
# to a model that has not been measured on the over-fill cases.
NUXT_FINDER_MODEL=
